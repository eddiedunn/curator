[Unit]
Description=Curator Service
After=network-online.target engram.service diarized-transcriber.service glimpse.service

[Container]
Image=registry.starbluesolutions.net/curator:latest
Pull=newer
ContainerName=curator

Network=gpu-services
Network=engram-net
PublishPort=127.0.0.1:8950:8950

# Health check lives here, not in the Dockerfile: the registry stores OCI
# images, which drop HEALTHCHECK, and the daemon shares this image.
HealthCmd=curl -fsS http://localhost:8950/health
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

Environment=CURATOR_ENGRAM_API_URL=http://engram:8800
Environment=CURATOR_TRANSCRIBE_SERVICE_URL=http://diarized-transcriber:8000
Environment=CURATOR_DATABASE_URL=sqlite:////data/curator.db
Environment=CURATOR_GLIMPSE_SERVICE_URL=http://glimpse:8730
Environment=CURATOR_DAEMON_ENABLED=true

Volume=/opt/curator/data:/data:Z
Volume=/opt/curator/cache:/cache:Z

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
